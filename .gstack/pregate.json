{
  "dependencies": {
    "test/**/*.serial.test.ts": [
      "test/scripts/serial-files.test.ts"
    ],
    "scripts/serial-files.tsv": [
      "test/scripts/serial-files.test.ts"
    ],
    ".github/workflows/ci-health.yml": [
      "test/scripts/ci-health-report.test.ts"
    ],
    "scripts/*-weights.metadata.json": [
      "test/scripts/mine-shard-weights.test.ts"
    ]
  },
  "guards": [
    {
      "id": "serial-manifest",
      "when": [
        "test/**/*.serial.test.ts",
        "scripts/serial-files.tsv",
        "scripts/run-serial-tests.sh"
      ],
      "command": "bun test test/scripts/serial-files.test.ts",
      "fix": "add the serial file's row to scripts/serial-files.tsv"
    },
    {
      "id": "regen-check",
      "when": [
        "scripts/classify-tests.ts",
        "scripts/structural-suites.tsv",
        "test/**/*.test.ts"
      ],
      "command": "bun scripts/regen-all.ts --check",
      "fix": "bun run regen:all and commit the regenerated files"
    }
  ],
  "sealed": {
    "paths": [
      "eval/reports/**",
      "**/sealed-confirmation/**",
      "**/hard-sealed/**",
      "**/counted/**"
    ],
    "transcripts": [
      "**/results.jsonl",
      "**/results.jsonl.gz",
      "**/usage.jsonl.gz"
    ],
    "visibility": "public"
  },
  "run_profiles": {
    "test": {
      "workflow": "test.yml",
      "events": [
        "workflow_dispatch",
        "push"
      ],
      "jobs": [
        "full-suite"
      ],
      "artifact": "full-suite-tree"
    }
  },
  "allowlist": [
    {
      "finding": "pii.phone.e164",
      "paths": [
        "scripts/*-weights.metadata.json"
      ],
      "reason": "shard-weight metadata records GitHub Actions run ids and commit counts, never phone numbers"
    }
  ]
}
