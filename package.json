{
  "name": "gbrain",
  "description": "Postgres-native personal knowledge brain with hybrid RAG search",
  "type": "module",
  "scripts": {
    "wave-security-scan": "bash scripts/wave-security-scan.sh",
    "audit:contributors": "bun scripts/contributor-audit.ts",
    "weights:mine": "bun run scripts/mine-shard-weights.ts",
    "test": "bash scripts/run-unit-parallel.sh",
    "test:full": "bun run verify && bash scripts/run-unit-parallel.sh && bun run test:slow && bash scripts/run-e2e.sh",
    "verify": "bash scripts/run-verify-parallel.sh",
    "check:file-url-pathname": "bash scripts/check-file-url-pathname.sh",
    "check:doc-history": "bash scripts/check-key-files-current-state.sh",
    "check:docs-repo-paths": "bun test --timeout 60000 test/docs-repo-paths.test.ts",
    "check:newlines": "bash scripts/check-trailing-newline.sh",
    "test:e2e": "bash scripts/run-e2e.sh",
    "test:slow": "bash scripts/run-slow-tests.sh",
    "test:stress": "bun run scripts/stress/run.ts",
    "test:heavy": "bash scripts/run-heavy.sh",
    "test:profile": "bash scripts/profile-tests.sh",
    "test:serial": "bash scripts/run-serial-tests.sh",
    "ci:local": "bash scripts/ci-local.sh",
    "ci:local:diff": "bash scripts/ci-local.sh --diff",
    "ci:select-e2e": "bun run scripts/select-e2e.ts",
    "typecheck": "node --max-old-space-size=8192 node_modules/typescript/bin/tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/gbrain-typecheck.tsbuildinfo",
    "check:privacy": "bash scripts/check-privacy.sh",
    "check:proposal-pii": "bash scripts/check-proposal-pii.sh",
    "check:test-names": "bash scripts/check-test-real-names.sh",
    "check:no-tracked-symlinks": "bash scripts/check-no-tracked-symlinks.sh",
    "check:test-isolation": "bash scripts/check-test-isolation.sh",
    "check:test-env-opt-ins": "bun scripts/check-test-env-opt-ins.ts",
    "check:weight-coverage": "bun scripts/check-weight-coverage.ts",
    "check:fixture-privacy": "bash scripts/check-fixture-privacy.sh",
    "check:guard-self-test": "bash scripts/guard-self-test.sh",
    "check:module-size": "bash scripts/check-module-size.sh",
    "check:function-size": "bun scripts/check-function-size.ts",
    "check:dynamic-ci": "bun scripts/check-dynamic-ci.ts",
    "check:retired-phrases": "bash scripts/check-retired-phrases.sh",
    "check:shared-tree-git": "bash scripts/check-shared-tree-git.sh",
    "check:bash32": "bash scripts/check-bash32.sh",
    "check:changelog-headings": "bun scripts/check-changelog-headings.ts",
    "check:structural-manifest": "bash scripts/check-structural-manifest.sh",
    "regen:all": "bun scripts/regen-all.ts",
    "check:regen-all": "bun scripts/regen-all.ts --check",
    "check:orphan-modules": "node scripts/check-orphan-modules.mjs",
    "check:test-placeholders": "node scripts/check-test-placeholders.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.125",
    "@ai-sdk/google": "^3.0.64",
    "@ai-sdk/openai": "^3.0.53",
    "@ai-sdk/openai-compatible": "^2.0.41",
    "@ai-sdk/provider-utils": "4.0.56",
    "@anthropic-ai/sdk": "^0.30.0",
    "@aws-sdk/client-s3": "^3.1028.0",
    "@aws-sdk/s3-request-presigner": "3.1028.0",
    "@dqbd/tiktoken": "^1.0.22",
    "@jsquash/avif": "^2.1.1",
    "@jsquash/png": "^3.1.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "ai": "^6.0.168",
    "chokidar": "^4.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "detect-libc": "2.0.4",
    "eventsource-parser": "^3.0.8",
    "exifr": "^7.1.3",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "heic-decode": "^2.1.0",
    "js-yaml": "^4.3.2",
    "jsonc-parser": "^3.3.1",
    "marked": "^18.0.2",
    "openai": "^4.0.0",
    "pgvector": "^0.2.0",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.22.6",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/bun": "latest",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "bun-types": "^1.3.13",
    "fast-check": "^4.8.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "license": "MIT",
  "version": "0.60.711.0",
  "overrides": {
    "@aws-sdk/util-format-url": "3.972.9",
    "@ai-sdk/provider-utils": "4.0.56",
    "@hono/node-server": "^2.1.6",
    "fast-uri": "^3.1.9",
    "body-parser": "^2.4.0",
    "fast-xml-builder": "^1.1.7",
    "fast-xml-parser": "^5.7.0",
    "form-data": "^4.0.6",
    "hono": "^4.13.16",
    "ip-address": "^10.7.4",
    "qs": "6.16.1",
    "js-yaml": "^4.3.2",
    "undici": "^6.29.1",
    "zod": "^4.6.6"
  }
}
